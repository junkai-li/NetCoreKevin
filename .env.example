# =====================================================================
# docker compose 环境变量示例
# 用法：复制为 .env（docker compose 会自动读取），按需修改后执行 docker compose up -d
#   PowerShell: Copy-Item .env.example .env
# 所有变量都有默认值，不创建 .env 也能直接启动
# =====================================================================

# ------------------- 端口（宿主机） -------------------
WEB_PORT=8080 # 前端入口，浏览器访问 http://localhost:8080
API_PORT=19901 # 后端直连 / Swagger：http://localhost:19901/swagger
MYSQL_PORT=13306 # 宿主机连库：127.0.0.1:13306
REDIS_PORT=16379
QDRANT_HTTP_PORT=16333 # Qdrant 控制台：http://localhost:16333/dashboard
QDRANT_GRPC_PORT=16334
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------- 账号密码（生产环境务必修改） -------------------
MYSQL_ROOT_PASSWORD=admin123
MYSQL_DATABASE=kevin_app
REDIS_PASSWORD=123456
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# ------------------- 运行行为 -------------------
# true：api 启动时执行 EF Core 迁移（首次部署自动建表 + 种子数据，升级自动增量迁移）
# 数据库已手工初始化过、不希望应用自动改表时设为 false
DB_AUTO_MIGRATE=true
# 镜像 tag，便于滚动升级/回滚
TAG=latest

# ------------------- 前端构建 -------------------
# 留空 = 同源部署（推荐），Nginx 把 /api、/KevinFlies 转发给 api 容器
# 前端需直连其他地址时才填绝对地址，例如 http://192.168.1.10:19901
VUE_APP_API_BASE_URL=
# 容器内 npm 源，官方源：https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com

# ------------------- 镜像源 -------------------
# 基础镜像默认官方地址，网络受限时可换镜像站
# MYSQL_IMAGE=mysql:8.0
# REDIS_IMAGE=redis:7-alpine
# QDRANT_IMAGE=qdrant/qdrant:latest
# RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
